<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Larp.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- config.example.json is the single source of the default menu (also used by the UI and the tests) -->
    <EmbeddedResource Include="..\..\config.example.json" LogicalName="config.example.json" />
  </ItemGroup>

</Project>
