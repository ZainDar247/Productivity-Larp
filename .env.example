# Copy this file to `.env` (it is git-ignored) and fill in your values.
#
# Reference any variable inside config.json as ${NAME}, e.g.
#   { "type": "rdp", "file": "${RDP_DIR}\\admin\\server1.rdp" }
#
# Lookup order — the first place that defines a name wins:
#   1. %APPDATA%\larp.productivity\.env   (installed app)
#   2. ./.env                              (running from the repo)
#   3. real environment variables

RDP_DIR=C:\Users\you\rdp
# EXAMPLE_API_TOKEN=change-me
